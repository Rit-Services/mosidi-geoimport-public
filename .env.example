# Vorlage: kopieren nach .env und Werte setzen. .env wird nie eingecheckt.
# Gleiche Variablennamen wie im MOSIDI-Compose.

# --- Datenbank (Ziel) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=geoimport_demo            # Demo: Name muss auf _demo enden; Betrieb: Datenbank der TH
POSTGRES_USER=geoimport
POSTGRES_PASSWORD=                    # PFLICHT – kein Standardwert; alternativ POSTGRES_PASSWORD_FILE
POSTGRES_HOST_PORT=55433              # nur lokal (127.0.0.1) veröffentlicht

# --- Pipeline ---
PIPELINE_ENV=demo                     # prod | demo | test
TARGET_CONFIG=target.demo.yaml        # Betrieb: target.yaml (Zielmodell der TH)
GEOIMPORT_DIFF_GEOMS=true             # Demo: Geometrien für die Änderungskarte sichern; Betrieb: false
LOG_LEVEL=INFO
LOG_FORMAT=json                       # json | text
TZ=Europe/Berlin
# GEOIMPORT_WEBHOOK_URL=              # optional, mit report.notify_webhook_env in pipeline.yaml

# --- Demo-Karte (nur lesend) ---
MAP_DB_USER=geoimport_map
MAP_DB_PASSWORD=                      # PFLICHT für Profil demo
MAP_PORT=8080
# Anmeldeseite der Karte – nur nötig, wenn die Karte nicht nur lokal erreichbar ist (ohne Kennwort: keine Anmeldung)
# MAP_AUTH_USER=
# MAP_AUTH_PASSWORD=                  # mindestens 12 Zeichen
# MAP_SESSION_SECRET=                 # openssl rand -hex 32
